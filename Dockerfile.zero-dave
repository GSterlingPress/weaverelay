FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr poppler-utils xz-utils ca-certificates coreutils && rm -rf /var/lib/apt/lists/*
COPY audit-pilot/runtime.00 audit-pilot/runtime.01 audit-pilot/runtime.02 audit-pilot/runtime.03 audit-pilot/runtime.04 audit-pilot/runtime.05 audit-pilot/runtime.06 audit-pilot/runtime.07 /tmp/runtime/
RUN cat /tmp/runtime/runtime.* | base64 --decode > /tmp/audit-runtime.tar.xz \
 && xz --test /tmp/audit-runtime.tar.xz \
 && tar -xJf /tmp/audit-runtime.tar.xz -C /app \
 && test -f /app/app.py \
 && rm -rf /tmp/runtime /tmp/audit-runtime.tar.xz
COPY audit-pilot/hardening_patch.py /tmp/hardening_patch.py
RUN python /tmp/hardening_patch.py /app && rm /tmp/hardening_patch.py
COPY audit-pilot/overall_factor_patch.py /tmp/overall_factor_patch.py
RUN python /tmp/overall_factor_patch.py /app && rm /tmp/overall_factor_patch.py
COPY audit-pilot/source_registry.py audit-pilot/consensus.py audit-pilot/financial_catalog.py audit-pilot/zero_dave_orchestrator.py audit-pilot/customer_reports.py audit-pilot/zero_dave_app.py /app/
RUN pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir reportlab pillow pillow-heif extract-msg pypdf openpyxl \
 && python -m py_compile /app/source_registry.py /app/consensus.py /app/financial_catalog.py /app/zero_dave_orchestrator.py /app/customer_reports.py /app/zero_dave_app.py \
 && useradd --create-home --uid 10001 audituser \
 && mkdir -p /tmp/contract-money-audit-jobs \
 && chown -R audituser:audituser /app /tmp/contract-money-audit-jobs
USER audituser
EXPOSE 8080
CMD ["sh","-c","uvicorn zero_dave_app:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
